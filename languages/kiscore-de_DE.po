#. Plugin Name of the plugin
#. Author of the plugin
#: kiscore.php
msgid "KIscore"
msgstr "KIscore"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: kiscore.php
msgid "https://kiscore.ai"
msgstr "https://kiscore.ai"

#. Description of the plugin
#: kiscore.php
msgid "Shows in KIscore which AI crawlers visit your site and which visitors come from ChatGPT, Perplexity and other AI assistants. Server-side, without script or cookie."
msgstr "Zeigt in KIscore, welche KI-Crawler deine Website besuchen und welche Besucher über ChatGPT, Perplexity und andere KI-Assistenten kommen. Serverseitig, ohne Script und Cookie."

#: includes/class-admin.php:68
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-admin.php:84
msgid "KIscore is active but not connected yet."
msgstr "KIscore ist aktiv, aber noch nicht verbunden."

#: includes/class-admin.php:86
msgid "Enter the connection key"
msgstr "Verbindungsschlüssel eintragen"

#: includes/class-admin.php:95
msgid "You are not allowed to do this."
msgstr "Du darfst diese Aktion nicht ausführen."

#: includes/class-admin.php:117
msgid "KIscore shows which AI crawlers visit your site and which visitors come from ChatGPT, Perplexity and other AI assistants. The plugin reports page views from your server. It adds no script and no cookie to your pages."
msgstr "KIscore zeigt, welche KI-Crawler deine Website besuchen und welche Besucher über ChatGPT, Perplexity und andere KI-Assistenten kommen. Das Plugin meldet Seitenaufrufe von deinem Server aus. Es fügt deinen Seiten weder Script noch Cookie hinzu."

#: includes/class-admin.php:134
msgid "Status"
msgstr "Status"

#: includes/class-admin.php:137
msgid "Last report"
msgstr "Letzte Meldung"

#: includes/class-admin.php:141
msgid "Connection"
msgstr "Verbindung"

#: includes/class-admin.php:146
msgid "Check connection"
msgstr "Verbindung prüfen"

#: includes/class-admin.php:148
msgid "Checks the connection key without sending visitor data."
msgstr "Prüft den Verbindungsschlüssel, ohne Besucherdaten zu senden."

#: includes/class-admin.php:152
msgid "Test visit"
msgstr "Testbesuch"

#. translators: %s: query string to append to a page URL
#: includes/class-admin.php:158
#, php-format
msgid "Open any page of your site with %s. The visit then appears in KIscore under KI-Verweise."
msgstr "Ruf eine beliebige Seite deiner Website mit %s auf. Der Besuch erscheint danach in KIscore unter „KI-Verweise“."

#: includes/class-admin.php:164
msgid "A page cache is active. Pages served from the cache do not reach WordPress and are not reported, so AI crawlers that only get cached pages can be missing in KIscore."
msgstr "Ein Seiten-Cache ist aktiv. Seiten aus dem Cache erreichen WordPress nicht und werden nicht gemeldet. KI-Crawler, die nur gecachte Seiten abrufen, können deshalb in KIscore fehlen."

#: includes/class-admin.php:184
msgid "Connection key"
msgstr "Verbindungsschlüssel"

#: includes/class-admin.php:205
msgid "Set in wp-config.php."
msgstr "In wp-config.php festgelegt."

#: includes/class-admin.php:206
msgid "Set as environment variable."
msgstr "Als Umgebungsvariable festgelegt."

#. translators: %s: link to the KIscore dashboard
#: includes/class-admin.php:211
#, php-format
msgid "Copy it from %s in the KIscore dashboard. It stays on your server and is not displayed here again."
msgstr "Kopiere ihn im KIscore-Dashboard unter %s. Er bleibt auf deinem Server und wird hier nicht wieder angezeigt."

#: includes/class-admin.php:212
msgid "Settings → Traffic tracking → WordPress"
msgstr "Einstellungen → Traffic-Tracking → WordPress"

#. translators: %s: site ID
#: includes/class-admin.php:222
#, php-format
msgid "Connected to site ID %s."
msgstr "Verbunden mit Site-ID %s."

#: includes/class-admin.php:252
msgid "No page view reported yet."
msgstr "Noch kein Seitenaufruf gemeldet."

#. translators: 1: time span such as "5 mins", 2: result of the report
#: includes/class-admin.php:258
#, php-format
msgid "%1$s ago: %2$s"
msgstr "vor %1$s: %2$s"

#: includes/class-admin.php:272
msgid "KIscore accepts data from this site."
msgstr "KIscore nimmt Daten dieser Website an."

#: includes/class-admin.php:277
msgid "KIscore rejected the connection key (HTTP 401). Copy it again from the KIscore dashboard."
msgstr "KIscore hat den Verbindungsschlüssel abgelehnt (HTTP 401). Kopiere ihn erneut aus dem KIscore-Dashboard."

#: includes/class-admin.php:279
msgid "KIscore did not accept the data (HTTP 422). Check that the subscription for this website is active."
msgstr "KIscore hat die Daten nicht angenommen (HTTP 422). Prüfe, ob das Abo für diese Website aktiv ist."

#: includes/class-admin.php:281
msgid "KIscore is limiting requests from this server right now (HTTP 429)."
msgstr "KIscore begrenzt gerade die Anfragen dieses Servers (HTTP 429)."

#. translators: %s: error message of the HTTP request
#: includes/class-admin.php:284
#, php-format
msgid "KIscore could not be reached: %s"
msgstr "KIscore ist nicht erreichbar: %s"

#. translators: %s: error message of the HTTP request
#: includes/class-admin.php:284
msgid "no answer"
msgstr "keine Antwort"

#. translators: %d: HTTP status code
#: includes/class-admin.php:287
#, php-format
msgid "KIscore answered with HTTP %d."
msgstr "KIscore antwortet mit HTTP %d."

#. translators: %s: IP address
#: includes/class-admin.php:318
#, php-format
msgid "WordPress receives requests from %s, a private address. Your site probably runs behind a proxy or CDN. Name the header with the visitor IP in wp-config.php, e.g. define( 'KISCORE_CLIENT_IP_HEADER', 'X-Real-IP' );"
msgstr "WordPress erhält Anfragen von %s, einer privaten Adresse. Deine Website läuft vermutlich hinter einem Proxy oder CDN. Nenn den Header mit der Besucher-IP in der wp-config.php, etwa define( 'KISCORE_CLIENT_IP_HEADER', 'X-Real-IP' );"

#. translators: %s: list of header names
#: includes/class-admin.php:326
#, php-format
msgid "Your current request carries: %s."
msgstr "Deine aktuelle Anfrage enthält: %s."

#: includes/class-settings.php:126
msgid "This is not a connection key. Copy it again from the KIscore dashboard; it has the form site-id.secret."
msgstr "Das ist kein Verbindungsschlüssel. Kopiere ihn erneut aus dem KIscore-Dashboard, er hat die Form site-id.secret."
